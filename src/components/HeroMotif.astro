---
// Hero de la homepage : motif UI/UX dessiné en canvas (voir src/scripts/hero-motif.ts)
// qui se trace à l'ouverture et se défait picto par picto au scroll ; le nom perd sa graisse puis s'efface.
---

<section class="hero" id="hero">
  <canvas class="hero__motif" aria-hidden="true"></canvas>
  <h1 class="hero__name"><b>Arthur</b><span>Jeunechamp</span></h1>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 686px;
    overflow: hidden;
    z-index: 0;
  }

  .hero__motif {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .hero__name {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    margin: 0;
    font-size: var(--name-size, 57px);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--color-cream);
    text-shadow: var(--glow-title);
    white-space: nowrap;
    will-change: translate;
    contain: layout style;
  }

  .hero__name b {
    display: block;
    font-weight: var(--font-weight-bold);
  }

  .hero__name span {
    display: block;
    font-weight: var(--font-weight-light);
  }

  @media (max-width: 768px) {
    .hero {
      height: min(686px, 88svh);
    }
  }
</style>

<script>
  import { initHeroMotif } from '../scripts/hero-motif';

  const start = () => initHeroMotif(document.getElementById('hero'));
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
  else start();
</script>
